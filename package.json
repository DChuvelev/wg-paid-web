{
  "name": "wg-paid-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.20.0",
    "npm": "11.19.0"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "@hey-api/json-schema-ref-parser": {
      "js-yaml": "4.3.1"
    }
  },
  "scripts": {
    "build": "npm run build --workspace @wg-paid/access && npm run build --workspace @wg-paid/admin",
    "dev": "npm run dev --workspace @wg-paid/access",
    "dev:admin": "npm run dev --workspace @wg-paid/admin",
    "generate:api": "node scripts/generate-api.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false -p tsconfig.tools.json && tsc --noEmit --pretty false -p packages/api && tsc --noEmit --pretty false -p packages/common && tsc --noEmit --pretty false -p packages/ui && tsc --noEmit --pretty false -p apps/access && tsc --noEmit --pretty false -p apps/admin"
  },
  "devDependencies": {
    "@eslint/js": "9.34.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "9.34.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "26.1.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "typescript": "5.9.2",
    "typescript-eslint": "8.41.0",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
