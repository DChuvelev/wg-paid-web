{
  "components": {
    "schemas": {
      "Compose": {
        "properties": {
          "audience": {
            "enum": [
              "active",
              "all"
            ],
            "title": "Audience",
            "type": "string"
          },
          "body": {
            "maxLength": 10000,
            "minLength": 1,
            "title": "Body",
            "type": "string"
          },
          "subject": {
            "maxLength": 220,
            "minLength": 1,
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "audience",
          "subject",
          "body"
        ],
        "title": "Compose",
        "type": "object"
      },
      "ComposePreview": {
        "properties": {
          "audience": {
            "enum": [
              "active",
              "all"
            ],
            "title": "Audience",
            "type": "string"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "recipient_count": {
            "title": "Recipient Count",
            "type": "integer"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          }
        },
        "required": [
          "audience",
          "subject",
          "body",
          "recipient_count"
        ],
        "title": "ComposePreview",
        "type": "object"
      },
      "ConfirmRequest": {
        "properties": {
          "confirmed_recipient_count": {
            "minimum": 1.0,
            "title": "Confirmed Recipient Count",
            "type": "integer"
          }
        },
        "required": [
          "confirmed_recipient_count"
        ],
        "title": "ConfirmRequest",
        "type": "object"
      },
      "DraftSummary": {
        "properties": {
          "audience": {
            "title": "Audience",
            "type": "string"
          },
          "body": {
            "title": "Body",
            "type": "string"
          },
          "confirmed_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confirmed At"
          },
          "counts": {
            "additionalProperties": {
              "type": "integer"
            },
            "title": "Counts",
            "type": "object"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "recipient_count": {
            "title": "Recipient Count",
            "type": "integer"
          },
          "state": {
            "title": "State",
            "type": "string"
          },
          "subject": {
            "title": "Subject",
            "type": "string"
          },
          "test_attempted_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Test Attempted At"
          }
        },
        "required": [
          "id",
          "audience",
          "state",
          "subject",
          "body",
          "recipient_count",
          "created_at",
          "confirmed_at",
          "test_attempted_at",
          "counts"
        ],
        "title": "DraftSummary",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
